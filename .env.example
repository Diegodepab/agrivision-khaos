# ==============================================================================
# AGRIVISION-KHAOS: CONFIGURACIÓN CENTRALIZADA (.env)
# ==============================================================================
# Este archivo documenta todas las variables configurables del pipeline.
# Copia este archivo a .env para personalizar tu entorno:
#     cp .env.example .env
#
# Las variables aquí definidas son leídas automáticamente por el Makefile
# y por Docker Compose. Si pasas una variable directamente por terminal
# (ej. make pipeline DATASET="OtroDataset"), la de la terminal tendrá prioridad.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUTAS Y VOLÚMENES EN LA MÁQUINA HOST
# ------------------------------------------------------------------------------
RAW_DATA_HOST_PATH=./data/raw
PROCESSED_DATA_HOST_PATH=./data/processed
CACHE_DATA_HOST_PATH=./data/cache
REPORTS_HOST_PATH=./reports

# ------------------------------------------------------------------------------
# 2. PUERTOS Y SERVICIOS WEB
# ------------------------------------------------------------------------------
FIFTYONE_PORT=5151
FIFTYONE_BIND_ADDRESS=127.0.0.1
DOCS_PORT=8080
DOCS_BIND_ADDRESS=127.0.0.1

# ------------------------------------------------------------------------------
# 3. ACELERACIÓN HARDWARE (CPU / GPU)
# ------------------------------------------------------------------------------
# TORCH_EXTRA: 'cpu' para máquinas sin GPU dedicada.
#              'cu130' para máquinas con GPU NVIDIA (CUDA 13.0 / driver >= 525).
TORCH_EXTRA=cpu

# REQUIRE_GPU: 0 = Permite ejecutarse en CPU.
#              1 = Falla en preflight si no detecta GPU CUDA disponible.
REQUIRE_GPU=0

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DEL DATASET Y PIPELINE
# ------------------------------------------------------------------------------
# Nombre que recibirá el dataset dentro de FiftyOne y carpetas de exportación:
DATASET=EnfermedadesFrutos

# Ruta de las imágenes crudas. Puedes usar la ruta del host ('data/raw/...')
# o la ruta interna del contenedor ('/datasets/raw/...').
RAW_DIR=/datasets/raw/tropicale/clasificacionFruto

# Perfil y política de curación:
PROFILE=quality-first
POLICY=configs/quality-first.yaml

# Por defecto se reservan 2 CPU lógicas, con un mínimo de 1 worker (16 -> 14).
# Descomenta para fijar manualmente el número de workers:
# WORKERS=4

# Formatos de exportación deseados (separados por comas):
OUTPUT_FORMATS=coco,yolo,classification

# Modo para detección de errores de etiquetado (Cleanlab): 'auto', 'on', 'off'
CLEANLAB_MODE=auto

# Umbrales máximos tolerados de descarte por fase y total:
MAX_PHASE_DROP=0.40
MAX_TOTAL_DROP=0.65

# ------------------------------------------------------------------------------
# 5. CONTROL DE ETAPAS (SALTAR / ACTIVAR FASES)
# ------------------------------------------------------------------------------
# RESUME: 1 = Reutiliza ejecuciones compatibles; 0 = Fuerza una ejecución nueva.
RESUME=1

# ENABLE_OCR:
#   Vacío = Usa quality.ocr_enabled de POLICY (false en quality-first).
#   0 = Desactivado. Muy recomendado en CPU para procesar datasets grandes
#       en minutos en lugar de horas.
#   1 = Activado (utiliza prefiltrado morfológico ultrarrápido antes de Tesseract).
ENABLE_OCR=

# SKIP_QUALITY: 1 = Salta la evaluación visual (blur, exposición, etc.)
SKIP_QUALITY=0

# SKIP_DUPLICATES: 1 = Salta la detección de duplicados exactos y visuales
SKIP_DUPLICATES=0

# SKIP_LABELS: 1 = Salta la auditoría de etiquetas y ontología
SKIP_LABELS=0

# ------------------------------------------------------------------------------
# 6. BALANCEO DE CLASES Y AUMENTACIÓN AGRONÓMICA
# ------------------------------------------------------------------------------
# BALANCE_CLASSES:
#   1 = Sintetiza imágenes aumentadas para clases minoritarias.
#       Las imágenes generadas quedan estrictamente confinadas al split 'train'
#       para evitar fugas de datos hacia validación o test.
#   0 = No aplica aumentación (mantiene dataset tal cual fue curado).
BALANCE_CLASSES=0

# BALANCE_TARGET:
#   'median' = Eleva las clases bajo la mediana hasta la mediana.
#   'mean'   = Eleva las clases bajo la media hasta la media.
#   'max'    = Eleva todas las clases al nivel de la clase mayoritaria.
#   Número   = (ej. 500) Eleva las clases hasta tener al menos ese número.
BALANCE_TARGET=median

# ------------------------------------------------------------------------------
# 7. ARMONIZACIÓN DE ETIQUETAS Y ONTOLOGÍA
# ------------------------------------------------------------------------------
# ONTOLOGY: Ruta al archivo YAML de mapeo de clases para unificar etiquetas de
# distintos datasets o corregir erratas tipográficas (dejar vacío si no se usa).
# Ejemplo: ONTOLOGY=reports/pipeline/EnfermedadesFrutos/20260909_063250_976802/proposed_ontology.yaml
ONTOLOGY=
