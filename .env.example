FIFTYONE_PORT=5151
FIFTYONE_BIND_ADDRESS=127.0.0.1
DOCS_PORT=8080
DOCS_BIND_ADDRESS=127.0.0.1

# Estas rutas pertenecen a la máquina que ejecuta Docker. Para datos remotos,
# monta primero NFS/SSHFS en el host GPU y apunta RAW_DATA_HOST_PATH al montaje.
RAW_DATA_HOST_PATH=./data/raw
PROCESSED_DATA_HOST_PATH=./data/processed
CACHE_DATA_HOST_PATH=./data/cache
REPORTS_HOST_PATH=./reports

# Mantén cpu hasta conocer el modelo de GPU y la versión del driver NVIDIA.
# Para GPU usa docker-compose.gpu.yml como override; consulta la guía remota.
TORCH_EXTRA=cpu
